<?xml version="1.0" encoding="utf-8"?>
<!-- ARIA aparece: fundido + leve "rebote" hacia arriba (cambio de pose en los widgets) -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="450" />
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="100%" android:duration="450" />
    <translate android:fromYDelta="6%" android:toYDelta="0" android:duration="450" />
</set>
