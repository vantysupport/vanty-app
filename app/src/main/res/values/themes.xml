<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base: la UI es 100 % Compose, esto solo cubre la ventana y la pantalla de arranque. -->
    <style name="Theme.Vanty" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vanty_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Vanty.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vanty_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Vanty</item>
    </style>
</resources>
