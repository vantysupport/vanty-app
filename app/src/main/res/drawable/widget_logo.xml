<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadradito azul de marca con la V de Vanty encima (ic_stat_vanty) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#2F86F2" android:endColor="#0B57C9" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_stat_vanty" android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp" />
</layer-list>
